<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;    esp.nombre_esp                                   AS especialidad,&#xa;    CONCAT(v.nombre_v, N&apos; &apos;, v.apellido_v)           AS veterinario,&#xa;    COUNT(*)                                         AS citas_completadas,&#xa;    SUM(c.costo_c)                                   AS ingresos_generados,&#xa;    CAST(AVG(c.costo_c) AS DECIMAL(10,2))            AS costo_promedio,&#xa;    RANK() OVER (PARTITION BY esp.id_especialidad&#xa;                 ORDER BY COUNT(*) DESC)             AS ranking_en_especialidad,&#xa;    CAST(100.0 * COUNT(*)&#xa;         / SUM(COUNT(*)) OVER (PARTITION BY esp.id_especialidad)&#xa;         AS DECIMAL(5,2))                            AS pct_de_la_especialidad&#xa;FROM clinica.citas c&#xa;JOIN personal.veterinario    v   ON v.id_veterinario  = c.id_veterinario&#xa;JOIN personal.especialidades esp ON esp.id_especialidad = v.id_especialidad&#xa;WHERE c.estado_c = N&apos;Completada&apos;&#xa;  AND c.fecha_c &gt;= DATEADD(YEAR, -1, SYSDATETIME())&#xa;GROUP BY esp.id_especialidad, esp.nombre_esp,&#xa;         v.id_veterinario, v.nombre_v, v.apellido_v&#xa;ORDER BY esp.nombre_esp, ranking_en_especialidad" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090042DF9A61762A4C513CE03E72457C0ACD0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="2.05441" StatementEstRows="40" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x02445D8886276A17" QueryPlanHash="0xF2891A9B4759DC38" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="3056" CachedPlanSize="152" CompileTime="14" CompileCPU="13" CompileMemory="1144"><MissingIndexes><MissingIndexGroup Impact="64.3884"><MissingIndex Database="[veterinaria_perf]" Schema="[clinica]" Table="[citas]"><ColumnGroup Usage="EQUALITY"><Column Name="[id_veterinario]" ColumnId="3"></Column><Column Name="[estado_c]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[fecha_c]" ColumnId="4"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[costo_c]" ColumnId="7"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="2560" SerialDesiredMemory="3056" RequiredMemory="2560" DesiredMemory="3056" RequestedMemory="3056" GrantWaitTime="0" MaxQueryMemory="796712" GrantedMemory="3056" MaxUsedMemory="960" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="3106696"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-09T02:47:27.08" ModificationCount="0" SamplingPercent="32.0363" Statistics="[_WA_Sys_00000003_66603565]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-09T02:47:27.05" ModificationCount="0" SamplingPercent="32.0363" Statistics="[_WA_Sys_00000004_66603565]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-09T02:19:51.86" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000002_60A75C0F]" Table="[veterinario]" Schema="[personal]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-09T02:19:51.86" Modifi