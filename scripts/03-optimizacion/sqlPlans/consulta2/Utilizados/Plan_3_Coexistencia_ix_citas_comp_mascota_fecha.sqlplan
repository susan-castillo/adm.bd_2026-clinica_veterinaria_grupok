<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH visitas AS (&#xa;    SELECT&#xa;        c.id_mascota,&#xa;        c.fecha_c,&#xa;        LAG(c.fecha_c) OVER (PARTITION BY c.id_mascota&#xa;                             ORDER BY c.fecha_c)     AS visita_anterior&#xa;    FROM clinica.citas c&#xa;    WHERE c.estado_c = N&apos;Completada&apos;&#xa;),&#xa;resumen AS (&#xa;    SELECT&#xa;        v.id_mascota,&#xa;        COUNT(*)                                                 AS total_visitas,&#xa;        MAX(v.fecha_c)                                           AS ultima_visita,&#xa;        CAST(AVG(DATEDIFF(DAY, v.visita_anterior, v.fecha_c) * 1.0)&#xa;             AS DECIMAL(10,2))                                   AS dias_promedio_entre_visitas,&#xa;        MAX(DATEDIFF(DAY, v.visita_anterior, v.fecha_c))         AS max_dias_entre_visitas&#xa;    FROM visitas v&#xa;    GROUP BY v.id_mascota&#xa;)&#xa;SELECT TOP (20)&#xa;    m.nombre_m                                                   AS mascota,&#xa;    r.total_visitas,&#xa;    r.dias_promedio_entre_visitas,&#xa;    r.max_dias_entre_visitas,&#xa;    r.ultima_visita,&#xa;    DATEDIFF(DAY, r.ultima_visita, SYSDATETIME())                AS dias_desde_ultima_visita&#xa;FROM resumen r&#xa;JOIN pacientes.mascotas m ON m.id_mascota = r.id_mascota&#xa;ORDER BY r.total_visitas DESC, m.id_mascota" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090096EC37350A043A4F706FE3DF9F8304800000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="1.44283" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB97B4A9B76992CD5" QueryPlanHash="0x9182FEB4E6B46389" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1536" CachedPlanSize="88" CompileTime="5" CompileCPU="3" CompileMemory="912"><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="1536" RequiredMemory="512" DesiredMemory="1536" RequestedMemory="1536" GrantWaitTime="0" MaxQueryMemory="838352" GrantedMemory="1536" MaxUsedMemory="808" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="3227224"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-14T06:23:48.81" ModificationCount="0" SamplingPercent="100" Statistics="[ix_citas_estado_fecha]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:23:48.64" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000006_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:23:48.99" ModificationCount="0" SamplingPercent="100" Statistics="[pk_mascotas]" Table="[mascotas]" Schema="[pacientes]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:23:48.84" ModificationCount="0" SamplingPercent="100" Statistics="[ix_citas_estado_mascota_fecha]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:23:48.86" ModificationCount="0" SamplingPercent="100" Statistics="[ix_cand_citas_comp_mascota_fecha]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="PAGEIOLATCH