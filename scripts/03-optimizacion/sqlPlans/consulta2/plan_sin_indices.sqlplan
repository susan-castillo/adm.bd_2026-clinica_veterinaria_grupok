<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH visitas AS (&#xa;    -- Cada visita completada junto con la fecha de la visita anterior&#xa;    SELECT&#xa;        c.id_mascota,&#xa;        c.fecha_c,&#xa;        LAG(c.fecha_c) OVER (PARTITION BY c.id_mascota&#xa;                             ORDER BY c.fecha_c)     AS visita_anterior&#xa;    FROM clinica.citas c&#xa;    WHERE c.estado_c = N&apos;Completada&apos;&#xa;),&#xa;resumen AS (&#xa;    -- Una fila por mascota: frecuencia y dias entre visitas&#xa;    SELECT&#xa;        v.id_mascota,&#xa;        COUNT(*)                                                 AS total_visitas,&#xa;        MAX(v.fecha_c)                                           AS ultima_visita,&#xa;        CAST(AVG(DATEDIFF(DAY, v.visita_anterior, v.fecha_c) * 1.0)&#xa;             AS DECIMAL(10,2))                                   AS dias_promedio_entre_visitas,&#xa;        MAX(DATEDIFF(DAY, v.visita_anterior, v.fecha_c))         AS max_dias_entre_visitas&#xa;    FROM visitas v&#xa;    GROUP BY v.id_mascota&#xa;)&#xa;SELECT TOP (20)&#xa;    m.nombre_m                                                   AS mascota,&#xa;    r.total_visitas,&#xa;    r.dias_promedio_entre_visitas,&#xa;    r.max_dias_entre_visitas,&#xa;    r.ultima_visita,&#xa;    DATEDIFF(DAY, r.ultima_visita, SYSDATETIME())                AS dias_desde_ultima_visita&#xa;FROM resumen r&#xa;JOIN pacientes.mascotas m ON m.id_mascota = r.id_mascota&#xa;ORDER BY r.total_visitas DESC, m.id_mascota" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900D1DCDA53D29A7ECC331BE8BBDEFAB4F60000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.61177" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB97B4A9B76992CD5" QueryPlanHash="0x1D9B55E3C64192D7" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="16" MemoryGrant="215048" CachedPlanSize="136" CompileTime="54" CompileCPU="16" CompileMemory="1768"><ThreadStat Branches="1" UsedThreads="16"><ThreadReservation NodeId="0" ReservedThreads="17"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="64.8298"><MissingIndex Database="[veterinaria_perf]" Schema="[clinica]" Table="[citas]"><ColumnGroup Usage="EQUALITY"><Column Name="[estado_c]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[id_mascota]" ColumnId="2"></Column><Column Name="[fecha_c]" ColumnId="4"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="4416" SerialDesiredMemory="148528" RequiredMemory="70920" DesiredMemory="215048" RequestedMemory="215048" GrantWaitTime="0" MaxQueryMemory="1309712" GrantedMemory="215048" MaxUsedMemory="40000" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="5290800"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-12T11:42:31.60" ModificationCount="0" SamplingPercent="32.0363" Statistics="[_WA_Sys_00000002_66603565]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-09T02:32:38.62" ModificationCount="0" SamplingPercent="32.0363" Statistics="[_WA_Sys_00000006_66603565]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-09T02:32:37.29" ModificationCount="0" SamplingPercent="100" Statistics="[pk_mascotas]" Table="[mascotas]" Schema="[pacientes]" Database="[veterinaria_perf]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="BPSORT" WaitTimeMs="221" WaitCount="1199"></Wait><Wait WaitType="LATCH_EX" WaitTimeMs="118" WaitCount="242"></Wait><Wait WaitType="CXSYNC_PORT" WaitTimeMs="81" WaitCount="17"></Wait><Wait WaitType="HTBUILD_AGG" WaitTimeMs="45" WaitCount="30"></Wait><Wait WaitType="RESERVED_MEMORY_ALLOCATION_EXT" WaitTimeMs="27" WaitCount="2132"></Wait><Wait WaitType="EXECSYNC" WaitTimeMs="12" WaitCount="68"></Wait><Wait WaitType="PAGEIOLATCH_SH" WaitTimeMs="8" WaitCount="21"></Wait><Wait WaitType="MEMORY_ALLOCATION_EXT" WaitTimeMs="8" WaitCount="4678"></Wait><Wait WaitType="HTDELETE_AGG" WaitTimeMs="5" WaitCount="30"></Wait><Wait WaitType="HTREPARTITION" WaitTimeMs="5" WaitCount="30"></Wait></WaitStats><QueryTimeStats ElapsedTime="81" CpuTime="868"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="20" EstimateIO="0" EstimateCPU="2e-06" AvgRowSize="140" EstimatedTotalSubtreeCost="3.61177" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1002"></ColumnReference><ColumnReference Column="Expr1003"></ColumnReference><ColumnReference Column="Expr1005"></ColumnReference><ColumnReference Column="Expr1006"></ColumnReference><ColumnReference Database="[veterinaria_perf]" Schema="[pacientes]" Table="[mascotas]" Alias="[m]" Column="nombre_m"></ColumnReference><ColumnReference Column="Expr1008"></ColumnReference></OutputList><ComputeScalar><DefinedValues><DefinedValue><ColumnReference Column="Expr1006"></ColumnReference><ScalarOperator ScalarString="CONVERT(decimal(10,2),[Expr1004],0)"><Convert DataType="decimal" Precision="10" Scale="2" Style="0" Implicit="0"><ScalarOperator><Ide