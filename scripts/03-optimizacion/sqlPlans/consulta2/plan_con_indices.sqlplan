<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH visitas AS (&#xa;    -- Cada visita completada junto con la fecha de la visita anterior&#xa;    SELECT&#xa;        c.id_mascota,&#xa;        c.fecha_c,&#xa;        LAG(c.fecha_c) OVER (PARTITION BY c.id_mascota&#xa;                             ORDER BY c.fecha_c)     AS visita_anterior&#xa;    FROM clinica.citas c&#xa;    WHERE c.estado_c = N&apos;Completada&apos;&#xa;),&#xa;resumen AS (&#xa;    -- Una fila por mascota: frecuencia y dias entre visitas&#xa;    SELECT&#xa;        v.id_mascota,&#xa;        COUNT(*)                                                 AS total_visitas,&#xa;        MAX(v.fecha_c)                                           AS ultima_visita,&#xa;        CAST(AVG(DATEDIFF(DAY, v.visita_anterior, v.fecha_c) * 1.0)&#xa;             AS DECIMAL(10,2))                                   AS dias_promedio_entre_visitas,&#xa;        MAX(DATEDIFF(DAY, v.visita_anterior, v.fecha_c))         AS max_dias_entre_visitas&#xa;    FROM visitas v&#xa;    GROUP BY v.id_mascota&#xa;)&#xa;SELECT TOP (20)&#xa;    m.nombre_m                                                   AS mascota,&#xa;    r.total_visitas,&#xa;    r.dias_promedio_entre_visitas,&#xa;    r.max_dias_entre_visitas,&#xa;    r.ultima_visita,&#xa;    DATEDIFF(DAY, r.ultima_visita, SYSDATETIME())                AS dias_desde_ultima_visita&#xa;FROM resumen r&#xa;JOIN pacientes.mascotas m ON m.id_mascota = r.id_mascota&#xa;ORDER BY r.total_visitas DESC, m.id_mascota" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900D1DCDA53D29A7ECC331BE8BBDEFAB4F60000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="2.86531" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB97B4A9B76992CD5" QueryPlanHash="0x2A80B8DDA271971D" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="66736" CachedPlanSize="72" CompileTime="6" CompileCPU="4" CompileMemory="1024"><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="66736" GrantedMemory="66736" MaxUsedMemory="2408"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="160" SerialDesiredMemory="66736" RequiredMemory="160" DesiredMemory="66736" RequestedMemory="66736" GrantWaitTime="0" MaxQueryMemory="1331432" GrantedMemory="66736" MaxUsedMemory="2408" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="5361904"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-12T11:46:07.93" ModificationCount="0" SamplingPercent="100" Statistics="[IX_citas_veterinario]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-12T11:46:19.01" ModificationCount="0" SamplingPercent="100" Statistics="[ix_citas_estado_fecha]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-12T11:46:07.87" ModificationCount="0" SamplingPercent="100" Statistics="[IX_citas_mascota]" Table="[citas]" Schema="[clinica]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-12T11:46:19.40" ModificationCount="0" SamplingPercent="100" Statistics="[ix_citas_estado_mascota_fecha]" Table="[citas]" Sche