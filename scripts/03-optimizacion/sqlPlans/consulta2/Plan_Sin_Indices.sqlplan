<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH visitas AS (&#xa;    SELECT&#xa;        c.id_mascota,&#xa;        c.fecha_c,&#xa;        LAG(c.fecha_c) OVER (PARTITION BY c.id_mascota&#xa;                             ORDER BY c.fecha_c)     AS visita_anterior&#xa;    FROM clinica.citas c&#xa;    WHERE c.estado_c = N&apos;Completada&apos;&#xa;),&#xa;resumen AS (&#xa;    SELECT&#xa;        v.id_mascota,&#xa;        COUNT(*)                                                 AS total_visitas,&#xa;        MAX(v.fecha_c)                                           AS ultima_visita,&#xa;        CAST(AVG(DATEDIFF(DAY, v.visita_anterior, v.fecha_c) * 1.0)&#xa;             AS DECIMAL(10,2))                                   AS dias_promedio_entre_visitas,&#xa;        MAX(DATEDIFF(DAY, v.visita_anterior, v.fecha_c))         AS max_dias_entre_visitas&#xa;    FROM visitas v&#xa;    GROUP BY v.id_mascota&#xa;)&#xa;SELECT TOP (20)&#xa;    m.nombre_m                                                   AS mascota,&#xa;    r.total_visitas,&#xa;    r.dias_promedio_entre_visitas,&#xa;    r.max_dias_entre_visitas,&#xa;    r.ultima_visita,&#xa;    DATEDIFF(DAY, r.ultima_visita, SYSDATETIME())                AS dias_desde_ultima_visita&#xa;FROM resumen r&#xa;JOIN pacientes.mascotas m ON m.id_mascota = r.id_mascota&#xa;ORDER BY r.total_visitas DESC, m.id_mascota" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090096EC37350A043A4F706FE3DF9F8304800000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="2.27805" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB97B4A9B76992CD5" QueryPlanHash="0xE8A613A09CD85136" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="16" MemoryGrant="24960" CachedPlanSize="96" CompileTime="9" CompileCPU="8" CompileMemory="1136"><ThreadStat Branches="2" UsedThreads="32"><ThreadReservation NodeId="0" ReservedThreads="32"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="45.8056"><MissingIndex Database="[db_veterinaria]" Schema="[clinica]" Table="[citas]"><ColumnGroup Usage="EQUALITY"><Column Name="[estado_c]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[id_mascota]" ColumnId="2"></Column><Column Name="[fecha_c]" ColumnId="4"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="640" SerialDesiredMemory="9576" RequiredMemory="16000" DesiredMemory="24960" RequestedMemory="24960" GrantWaitTime="0" MaxQueryMemory="701608" GrantedMemory="24960" MaxUsedMemory="10912" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="2650760"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-14T05:14:33.10" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000002_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T05:14:32.95" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000006_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T05:14:33.20" ModificationCount="0" SamplingPercent="100" Statistics="[pk_mascotas]" Table="[mascotas]" Schema="[pacientes]" Database="[db_veterinaria]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="LATCH_EX" WaitTimeMs="144" WaitCount="47"></Wait><Wait WaitType="CXSYNC_PORT" WaitTimeMs="125" WaitCount="49"></Wait><Wait WaitType="CXPACKET" WaitTimeMs="27" WaitCount="37"></Wait><Wait WaitType="PAGEIOLATCH_SH" WaitTimeMs="11" WaitCount="55"></Wait><Wait WaitType="CXSYNC_CONSUMER" WaitTimeMs="5" WaitCount="15"></Wait><Wait WaitType="EXECSYNC" WaitTimeMs="2" WaitCount="16"></Wait><Wait WaitType="SESSION_WAIT_STATS_CHILDREN" WaitTimeMs="2" WaitCount="19"></Wait><Wait WaitType="MEMORY_ALLOCATION_EXT" WaitTimeMs="1" WaitCount="2027"></Wait></WaitStats><QueryTimeStats ElapsedTime="37" CpuTime="297"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="20" EstimateIO="0" EstimateCPU="2e-06" AvgRowSize="140" EstimatedTotalSubtreeCost="2.27805" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1002"></ColumnReference><ColumnReference Column="Expr1003"></ColumnReference><ColumnReference Column="Expr1005"></ColumnReference><ColumnReference Column="Expr1006"></ColumnReference><ColumnReference Database="[db_veterinaria]" Schema="[pacientes]" Table="[mascotas]" Alias="[m]" Column="nombre_m"></ColumnReference><ColumnReference Column="Expr1008"></ColumnReference></OutputList><ComputeScalar><DefinedValues><DefinedValue><ColumnReference Column="Expr1006"></ColumnReference><ScalarOperator ScalarString="CONVERT(decimal(10,2),[Expr1004],0)"><Convert DataType="decimal" Precision="10" Scale="2" Style="0" Implicit="0"><ScalarOperator><Identifier><ColumnReference Column="Expr1004"></ColumnReference></Identifier></ScalarOperator></Convert></ScalarOperator></DefinedValue><DefinedValue><ColumnReference Column="Expr1008"></ColumnReference><ScalarOperator ScalarString="datediff(day,CONVERT_IMPLICIT(datetimeoffset(7),[Expr1003],0),CONVERT_IMPLICIT(datetimeoffset(7),sysdatetime(),0))"><Intrinsic FunctionName="datediff"><ScalarOperator><Const ConstValue="(4)"></Const></ScalarOperator><ScalarOperator><Convert DataType="datetimeoffset" Scale="7" Style="0" Implicit="1"><ScalarOperator><Identifier><ColumnReference Column="Expr1003"></ColumnReference></Identifier></ScalarOperator></Convert></ScalarOperator><ScalarOperator><Identifier><ColumnReference Column="ConstExpr1009"><ScalarOperator><Convert DataType="datetimeoffset" Scale="7" Style="0" Implicit="1"><ScalarOperator><Intrinsic FunctionName="sysdatetime"></Intrinsic></ScalarOperator></Convert></ScalarOperator></ColumnReference></Identifier></ScalarOperator></Intrinsic></ScalarOperator></DefinedValue></DefinedValues><RelOp NodeId="1" PhysicalOp="Top" LogicalOp="Top" EstimateRows="20" EstimateIO="0" EstimateCPU="2e-06" AvgRowSize="144" EstimatedTotalSubtreeCost="2.27805" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1002"></ColumnReference><ColumnReference Column="Expr1003"></ColumnReference><ColumnReference Column="Expr1004"></ColumnReference><ColumnReference Column="Expr1005"></ColumnReference><ColumnReference Database="[db_veterinaria]" Schema="[pacientes]" Table="[mascotas]" Alias="[m]" Column="nombre_m"></ColumnReference></OutputList><RunTimeInformation><RunTimeCountersPerThread Thread="0" ActualRows="20" Batches="0" ActualElapsedms="33" ActualCPUms="0" ActualEndOfScans="1" ActualExecutions="1" ActualExecutionMode="Row"></RunTimeCountersPerThread></RunTimeInformation><Top RowCount="0" IsPercent="0" WithTies="0"><TopExpression><ScalarOperator ScalarString="(20)"><Const ConstValue="(20)"></Const></ScalarOperator></TopExpression><RelOp NodeId="2" PhysicalOp="Parallelism" LogicalOp="Gather Streams" EstimateRows="20" EstimateRowsWithoutRowGoal="9328.69" EstimateIO="0" EstimateCPU="0.0286501" AvgRowSize="160" EstimatedTotalSubtreeCost="2.27804" Parallel="1" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode