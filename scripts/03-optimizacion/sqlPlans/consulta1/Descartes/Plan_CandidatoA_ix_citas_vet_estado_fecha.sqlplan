<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;    esp.nombre_esp                                   AS especialidad,&#xa;    CONCAT(v.nombre_v, N&apos; &apos;, v.apellido_v)           AS veterinario,&#xa;    COUNT(*)                                         AS citas_completadas,&#xa;    SUM(c.costo_c)                                   AS ingresos_generados,&#xa;    CAST(AVG(c.costo_c) AS DECIMAL(10,2))            AS costo_promedio,&#xa;    RANK() OVER (PARTITION BY esp.id_especialidad&#xa;                 ORDER BY COUNT(*) DESC)             AS ranking_en_especialidad,&#xa;    CAST(100.0 * COUNT(*)&#xa;         / SUM(COUNT(*)) OVER (PARTITION BY esp.id_especialidad)&#xa;         AS DECIMAL(5,2))                            AS pct_de_la_especialidad&#xa;FROM clinica.citas c&#xa;JOIN personal.veterinario    v   ON v.id_veterinario    = c.id_veterinario&#xa;JOIN personal.especialidades esp ON esp.id_especialidad = v.id_especialidad&#xa;WHERE c.estado_c = N&apos;Completada&apos;&#xa;  AND c.fecha_c &gt;= DATEADD(YEAR, -1, SYSDATETIME())&#xa;GROUP BY esp.id_especialidad, esp.nombre_esp,&#xa;         v.id_veterinario, v.nombre_v, v.apellido_v&#xa;ORDER BY esp.nombre_esp, ranking_en_especialidad" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09006E2309C5CCC2615346D334B9FAB68DF70000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.584781" StatementEstRows="40" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x02445D8886276A17" QueryPlanHash="0x94F3A8F57D394A50" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1136" CachedPlanSize="120" CompileTime="5" CompileCPU="4" CompileMemory="848"><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="1136" RequiredMemory="1024" DesiredMemory="1136" RequestedMemory="1136" GrantWaitTime="0" MaxQueryMemory="795488" GrantedMemory="1136" MaxUsedMemory="24" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="3026024"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-14T06:04:04.68" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:04:04.70" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:04:04.73" ModificationCount="0" SamplingPercent="100" Statistics="[ix_citas_estado_fecha]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:04:04.57" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000006_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:04:04.86" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000002_60A75C0F]" Table="[veterinario]" Schema="[personal]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:04:04.85" ModificationCount="0" SamplingPercent="100" Statistics="[pk_veterinario]" Table="[veterinario]" Schema=