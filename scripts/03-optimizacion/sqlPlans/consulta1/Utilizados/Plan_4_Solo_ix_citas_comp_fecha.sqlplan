<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;    esp.nombre_esp                                   AS especialidad,&#xa;    CONCAT(v.nombre_v, N&apos; &apos;, v.apellido_v)           AS veterinario,&#xa;    COUNT(*)                                         AS citas_completadas,&#xa;    SUM(c.costo_c)                                   AS ingresos_generados,&#xa;    CAST(AVG(c.costo_c) AS DECIMAL(10,2))            AS costo_promedio,&#xa;    RANK() OVER (PARTITION BY esp.id_especialidad&#xa;                 ORDER BY COUNT(*) DESC)             AS ranking_en_especialidad,&#xa;    CAST(100.0 * COUNT(*)&#xa;         / SUM(COUNT(*)) OVER (PARTITION BY esp.id_especialidad)&#xa;         AS DECIMAL(5,2))                            AS pct_de_la_especialidad&#xa;FROM clinica.citas c&#xa;JOIN personal.veterinario    v   ON v.id_veterinario    = c.id_veterinario&#xa;JOIN personal.especialidades esp ON esp.id_especialidad = v.id_especialidad&#xa;WHERE c.estado_c = N&apos;Completada&apos;&#xa;  AND c.fecha_c &gt;= DATEADD(YEAR, -1, SYSDATETIME())&#xa;GROUP BY esp.id_especialidad, esp.nombre_esp,&#xa;         v.id_veterinario, v.nombre_v, v.apellido_v&#xa;ORDER BY esp.nombre_esp, ranking_en_especialidad" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09006E2309C5CCC2615346D334B9FAB68DF70000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.770752" StatementEstRows="40" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x02445D8886276A17" QueryPlanHash="0x46DA304FF9B4E36C" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="2968" CachedPlanSize="152" CompileTime="7" CompileCPU="6" CompileMemory="1064"><MissingIndexes><MissingIndexGroup Impact="58.6392"><MissingIndex Database="[db_veterinaria]" Schema="[clinica]" Table="[citas]"><ColumnGroup Usage="EQUALITY"><Column Name="[id_veterinario]" ColumnId="3"></Column><Column Name="[estado_c]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[fecha_c]" ColumnId="4"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[costo_c]" ColumnId="7"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="2560" SerialDesiredMemory="2968" RequiredMemory="2560" DesiredMemory="2968" RequestedMemory="2968" GrantWaitTime="0" MaxQueryMemory="963784" GrantedMemory="2968" MaxUsedMemory="640" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="3786640"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-14T06:57:00.43" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:57:00.45" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:57:00.32" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000006_66603565]" Table="[citas]" Schema="[clinica]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T06:57:00.61" ModificationCount="0" Sampli