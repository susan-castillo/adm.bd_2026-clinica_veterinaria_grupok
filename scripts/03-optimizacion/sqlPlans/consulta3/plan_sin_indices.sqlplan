<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH mensual AS (&#xa;    -- Total de facturas pagadas por mes&#xa;    SELECT&#xa;        DATEFROMPARTS(YEAR(f.fecha_emision_f),&#xa;                      MONTH(f.fecha_emision_f), 1)               AS mes,&#xa;        COUNT(*)                                                 AS facturas_emitidas,&#xa;        SUM(f.total_f)                                           AS total_mes&#xa;    FROM facturacion.facturas f&#xa;    WHERE f.estado_f = N&apos;Pagada&apos;&#xa;    GROUP BY DATEFROMPARTS(YEAR(f.fecha_emision_f),&#xa;                           MONTH(f.fecha_emision_f), 1)&#xa;)&#xa;SELECT&#xa;    mes,&#xa;    facturas_emitidas,&#xa;    total_mes,&#xa;    SUM(total_mes) OVER (ORDER BY mes&#xa;        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)        AS facturacion_acumulada,&#xa;    CAST(AVG(total_mes) OVER (ORDER BY mes&#xa;        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)&#xa;         AS DECIMAL(12,2))                                       AS promedio_movil_3_meses,&#xa;    CAST(100.0 * (total_mes - LAG(total_mes) OVER (ORDER BY mes))&#xa;         / NULLIF(LAG(total_mes) OVER (ORDER BY mes), 0)&#xa;         AS DECIMAL(7,2))                                        AS variacion_pct_mes_anterior&#xa;FROM mensual&#xa;ORDER BY mes" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900E2921D1C90886A6B223442F12AB7331A0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="1.54895" StatementEstRows="1175" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x38AE3E63484BCD0B" QueryPlanHash="0x96D054464C894253" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="70064" CachedPlanSize="112" CompileTime="122" CompileCPU="16" CompileMemory="1192"><MissingIndexes><MissingIndexGroup Impact="60.9505"><MissingIndex Database="[veterinaria_perf]" Schema="[facturacion]" Table="[facturas]"><ColumnGroup Usage="EQUALITY"><Column Name="[estado_f]" ColumnId="4"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[fecha_emision_f]" ColumnId="3"></Column><Column Name="[total_f]" ColumnId="5"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="70064" GrantedMemory="70064" MaxUsedMemory="1632"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="3248" SerialDesiredMemory="70064" RequiredMemory="3248" DesiredMemory="70064" RequestedMemory="70064" GrantWaitTime="0" MaxQueryMemory="1298856" GrantedMemory="70064" MaxUsedMemory="1632" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="5247768"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-12T11:44:39.83" ModificationCount="0" SamplingPercent="92.8571" Statistics="[_WA_Sys_00000003_0A9D95DB]" Table="[facturas]" Schema="[facturacion]" Database="[veterinaria_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-12T11:44:39.80" ModificationCount="0" SamplingPercent="92.8571" Statistics="[_WA_Sys_00000004_0A9D95DB]" Table="[facturas]" Schema="[facturacion]" Database="[veterinaria_perf]"></StatisticsInfo></OptimizerStatsUsage><QueryTimeStats ElapsedTime="27" CpuTime="27"></QueryTimeStats><RelOp NodeId="0" Ph