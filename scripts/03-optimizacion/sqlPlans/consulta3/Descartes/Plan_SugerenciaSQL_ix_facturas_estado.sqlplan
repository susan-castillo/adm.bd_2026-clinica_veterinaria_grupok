<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4085.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH mensual AS (&#xa;    SELECT&#xa;        DATEFROMPARTS(YEAR(f.fecha_emision_f),&#xa;                      MONTH(f.fecha_emision_f), 1)               AS mes,&#xa;        COUNT(*)                                                 AS facturas_emitidas,&#xa;        SUM(f.total_f)                                           AS total_mes&#xa;    FROM facturacion.facturas f&#xa;    WHERE f.estado_f = N&apos;Pagada&apos;&#xa;    GROUP BY DATEFROMPARTS(YEAR(f.fecha_emision_f),&#xa;                           MONTH(f.fecha_emision_f), 1)&#xa;)&#xa;SELECT&#xa;    mes,&#xa;    facturas_emitidas,&#xa;    total_mes,&#xa;    SUM(total_mes) OVER (ORDER BY mes&#xa;        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)        AS facturacion_acumulada,&#xa;    CAST(AVG(total_mes) OVER (ORDER BY mes&#xa;        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW)&#xa;         AS DECIMAL(12,2))                                       AS promedio_movil_3_meses,&#xa;    CAST(100.0 * (total_mes - LAG(total_mes) OVER (ORDER BY mes))&#xa;         / NULLIF(LAG(total_mes) OVER (ORDER BY mes), 0)&#xa;         AS DECIMAL(7,2))                                        AS variacion_pct_mes_anterior&#xa;FROM mensual&#xa;ORDER BY mes" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900167CEDFC9F3D0248EC8C943629193BCC0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.678239" StatementEstRows="1094" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x38AE3E63484BCD0B" QueryPlanHash="0xA0A930AC05C81AE9" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1920" CachedPlanSize="144" CompileTime="5" CompileCPU="4" CompileMemory="952"><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="1920" RequiredMemory="1536" DesiredMemory="1920" RequestedMemory="1920" GrantWaitTime="0" MaxQueryMemory="808312" GrantedMemory="1920" MaxUsedMemory="328" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80595" EstimatedPagesCached="80595" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="3149952"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-14T14:10:51.21" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_0A9D95DB]" Table="[facturas]" Schema="[facturacion]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T14:10:51.16" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_0A9D95DB]" Table="[facturas]" Schema="[facturacion]" Database="[db_veterinaria]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T14:10:51.23" ModificationCount="0" SamplingPercent="100" Statistics="[ix_sug_facturas_estado]" Table="[facturas]" Schema="[facturacion]" Database="[db_veterinaria]"></StatisticsInfo></OptimizerStatsUsage><QueryTimeStats ElapsedTime="19" CpuTime="19"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1094" EstimateIO="0" EstimateCPU="0.0001094" AvgRowSize="62" EstimatedTotalSubtreeCost="0.678239" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1001"></ColumnReference><ColumnReference Column="Expr1002"></ColumnReference><ColumnReference Column="Expr1003"></ColumnReferenc